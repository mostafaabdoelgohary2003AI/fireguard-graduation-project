# ─────────────────────────────────────────────────────────────
# FireGuard — Environment Variables Template
# ─────────────────────────────────────────────────────────────
# Copy this file into the appropriate service directory and
# rename it to `.env` before starting the application.
#
#   cp .env.example backend/.env
#   cp .env.example ai_service/.env
#
# Lines starting with '#' are comments.
# ─────────────────────────────────────────────────────────────


# ╔═══════════════════════════════════════════════════════════╗
# ║  BACKEND (Django REST Framework)                         ║
# ╠═══════════════════════════════════════════════════════════╣
# ║  Location: backend/.env                                  ║
# ╚═══════════════════════════════════════════════════════════╝

# Django secret key — CHANGE THIS in production
SECRET_KEY=unsafe-dev-key-change-me

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Path to Firebase service-account JSON (optional — push notifications skipped if missing)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ── Database (reserved for future PostgreSQL migration) ─────
# Not used by Django — SQLite is the active database.
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=firedb
# DB_USER=fireuser
# DB_PASSWORD=firepassword

# Internal URL for the AI service (Docker DNS or localhost)
AI_SERVICE_URL=http://ai_service:8001


# ╔═══════════════════════════════════════════════════════════╗
# ║  AI SERVICE (FastAPI + YOLOv8)                           ║
# ╠═══════════════════════════════════════════════════════════╣
# ║  Location: ai_service/.env                               ║
# ╚═══════════════════════════════════════════════════════════╝

# Where the AI service posts detected events
DJANGO_BACKEND_URL=http://localhost:8000


# ╔═══════════════════════════════════════════════════════════╗
# ║  FLUTTER (build-time --dart-define flags)                ║
# ╠═══════════════════════════════════════════════════════════╣
# ║  These are NOT loaded from .env files — pass them        ║
# ║  via the command line at build time.                     ║
# ╚═══════════════════════════════════════════════════════════╝

# flutter run --dart-define=BACKEND_URL=http://10.0.2.2:8000   (Android emulator)
# flutter run --dart-define=BACKEND_URL=http://localhost:8000   (iOS simulator)
# flutter run --dart-define=BACKEND_URL=https://your-domain.com (production)

# AI service URL (for direct camera-to-AI frame uploads from the mobile app)
# flutter run --dart-define=AI_BASE_URL=http://192.168.x.x:8001
